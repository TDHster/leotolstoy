.venv/
.pytest_cache/

# Секреты: env-файлы во всех вариантах написания, кроме примера.
# ВАЖНО: gitignore НЕ поддерживает комментарии в конце строки — только отдельной строкой.
.env
.env.*
*.env
!.env.example

# прочие возможные секреты
.deploy
*.pem
*.key
*secret*
*credential*

# MCP-конфиг Cursor: реальный файл может содержать токен MCP_API_KEY —
# не в git. Пример без секретов: .cursor/mcp.json.example (коммитится).
.cursor/mcp.json

__pycache__/
*.pyc
.DS_Store

# Данные и артефакты.
# EPUB издания 1978 г. — под авторским правом издательства, НЕ выкладывать
# в open-source (тексты Толстого public domain, но эта редактура/вёрстка — нет).
# Пользователь подставляет свои файлы в data/. Матчим на любой глубине.
*.epub
data/*
!data/README.md

# Индексы эмбеддингов собираются на месте (make embeddings / make embeddings-qwen),
# весят сотни МБ — не для git. Покрывает index/, index.backup/, index.<model>/
index*/

# TLS-сертификаты (приватный ключ — секрет)
certs/

# favicon: лицензия картинки не наша — не выкладываем в open-source.
# Положите свой server/static/favicon.ico локально (эндпоинт отдаст его, если есть).
server/static/favicon.ico

# Кэш моделей fastembed/HF, если ляжет локально
.fastembed_cache/

# uv: окружение игнорируем, а uv.lock КОММИТИМ (воспроизводимость)
# .venv уже покрыт выше; uv.lock намеренно НЕ игнорируется

# Документация миграции (может содержать чувствительную информацию о сервере)
migrate-to-https.md
server/static/Фотопортрет_Л._Толстого_(Шерер,_Набгольц_и_Ко)_(cropped).jpg
