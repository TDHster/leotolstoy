# Скопируйте в .env и заполните. .env не коммитить (см .gitignore).

# --- Авторизация (Basic Auth, один пользователь) ---
APP_USER=admin
APP_PASS=смените-на-длинный-пароль

# --- Провайдер генерации (любой OpenAI-совместимый API) ---
LLM_API_KEY=sk-or-...
LLM_MODEL=deepseek/deepseek-chat

# Базовый URL API БЕЗ хвоста /chat/completions (его добавит сервер).
# По умолчанию OpenRouter. Примеры для смены провайдера:
#   OpenRouter :  https://openrouter.ai/api/v1     (модели: deepseek/deepseek-chat, anthropic/claude-3.5-sonnet, ...)
#   OpenAI     :  https://api.openai.com/v1        (модели: gpt-4o-mini, gpt-4o, ...)
#   DeepSeek   :  https://api.deepseek.com/v1      (модели: deepseek-chat, deepseek-reasoner)
#   Together   :  https://api.together.xyz/v1
#   Ollama     :  http://localhost:11434/v1        (локально; ключ можно любой)
LLM_BASE_URL=https://openrouter.ai/api/v1

# Старые имена OPENROUTER_API_KEY / OPENROUTER_MODEL тоже поддерживаются
# (fallback для обратной совместимости), но LLM_* имеют приоритет.

# --- Поиск ---
TOP_K=5
# Ограничить источники: письмо / дневник / письмо,дневник (пусто = всё)
SRC_TYPES=

# --- Лимиты и защита ---
# Максимум символов в сообщении пользователя (длиннее → 422).
MAX_MESSAGE_CHARS=2000
# Rate limit на /chat (защита API-счёта от абьюза). Формат limits: "N/period".
RATE_LIMIT_CHAT=20/minute;200/day
# Rate limit на вход / (тормозит брутфорс пароля).
RATE_LIMIT_LOGIN=30/minute
# Задержка ответа при неверном пароле, сек (удорожает перебор).
AUTH_FAIL_DELAY=0.5
# Таймаут запроса к LLM-провайдеру, сек.
LLM_TIMEOUT=120
# Уровень логов: DEBUG / INFO / WARNING / ERROR.
LOG_LEVEL=INFO
# Логировать ТЕКСТ запросов и ответов (1/true/yes). По умолчанию выкл —
# это персональные данные пользователей. Включайте осознанно на своём сервере.
LOG_QUERIES=

# --- Эмбеддинги ---
# ВАЖНО: модель и версия fastembed на сервере должны совпадать с теми,
# которыми собран индекс локально (иначе векторы несовместимы).
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBED_DIM=384
EMBED_THREADS=2
