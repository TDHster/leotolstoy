# Скопируйте в .env и заполните. .env не коммитить (см .gitignore).

# --- Авторизация (Basic Auth, один пользователь) ---
APP_USER=admin
APP_PASS=смените-на-длинный-пароль

# --- Провайдер генерации (любой OpenAI-совместимый API) ---
LLM_API_KEY=sk-or-...
LLM_MODEL=deepseek-chat

# Базовый URL API БЕЗ хвоста /chat/completions (его добавит сервер).
# По умолчанию DeepSeek (работает из России). Примеры для смены провайдера:
#   DeepSeek   :  https://api.deepseek.com         (модели: deepseek-chat, deepseek-reasoner)
#   OpenRouter :  https://openrouter.ai/api/v1     (модели: deepseek/deepseek-chat, anthropic/claude-3.5-sonnet, ...)
#   OpenAI     :  https://api.openai.com/v1        (модели: gpt-4o-mini, gpt-4o, ...)
#   Together   :  https://api.together.xyz/v1
#   Ollama     :  http://localhost:11434/v1        (локально; ключ можно любой)
LLM_BASE_URL=https://api.deepseek.com

# Старые имена OPENROUTER_API_KEY / OPENROUTER_MODEL тоже поддерживаются
# (fallback для обратной совместимости), но LLM_* имеют приоритет.

# --- Поиск ---
TOP_K=5
# Ограничить источники: письмо / дневник / записная книжка / статья / трактат
# (через запятую; пусто = все типы)
SRC_TYPES=

# --- Лимиты и защита ---
# Максимум символов в сообщении пользователя (длиннее → 422).
MAX_MESSAGE_CHARS=2000
# Rate limit на /chat (защита API-счёта от абьюза). Формат limits: "N/period".
RATE_LIMIT_CHAT=20/minute;200/day
# Rate limit на вход / (тормозит брутфорс пароля).
RATE_LIMIT_LOGIN=30/minute
# Rate limit на GET /doc/{id} (полный текст источника по клику на фрагмент).
RATE_LIMIT_DOC=30/minute
# Задержка ответа при неверном пароле, сек (удорожает перебор).
AUTH_FAIL_DELAY=0.5
# Таймаут запроса к LLM-провайдеру, сек.
LLM_TIMEOUT=120
# Уровень логов: DEBUG / INFO / WARNING / ERROR.
LOG_LEVEL=INFO
# Логировать ТЕКСТ запросов и ответов (1/true/yes). По умолчанию выкл —
# это персональные данные пользователей. Включайте осознанно на своём сервере.
LOG_QUERIES=

# --- Эмбеддинги ---
# ВАЖНО: модель и версия fastembed на сервере должны совпадать с теми,
# которыми собран индекс локально (иначе векторы несовместимы).
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBED_DIM=384
EMBED_THREADS=2

# Типы документов для индексации (через запятую): письмо, дневник,
# записная книжка, статья, трактат (корпус Verbatis). Пусто или не задано
# = все типы. Только для сборки индекса; рантайм-фильтр поиска — SRC_TYPES.
EMBED_TYPES=

# --- Внешние эмбеддинги (НЕ ИСПОЛЬЗУЕТСЯ: Qwen отключён, работаем только на
# локальной модели). Секция оставлена на случай возвращения к API-эмбеддингам —
# код (scripts/build_embeddings_api.py, server/embedders.py) дремлет в репо,
# таргета в Makefile нет.
#
# Модели на OpenRouter (2026):
#   qwen/qwen3-embedding-8b    — $0.01/M tokens, 8B params, лучшее качество
#   qwen/qwen3-embedding-4b    — $0.02/M tokens, 4B params
#   nvidia/nemotron-3-embed-1b — бесплатно, 1B params
#
# Стоимость векторизации 90 томов (~25M tokens):
#   Qwen3-8B: ~$0.25, Nemotron: $0
# Стоимость runtime (1000 запросов пользователей):
#   Qwen3-8B: ~$0.01, Nemotron: $0
EXTERNAL_EMBEDDER_API_KEY=
EXTERNAL_EMBEDDER_MODEL=qwen/qwen3-embedding-8b
EXTERNAL_EMBEDDER_ENDPOINT=https://openrouter.ai/api/v1

# Пин апстрим-провайдера OpenRouter (slug или список через запятую).
# ОБЯЗАТЕЛЬНО для внешнего индекса: сборка и runtime должны ходить к одному
# провайдеру, иначе векторы несравнимы (часть апстримов квантизует модель,
# напр. siliconflow отдаёт qwen3-embedding-8b в fp8).
# Дефолт в коде: nebius (неквантизованный апстрим Qwen3-8B).
# Для qwen3-embedding-4b укажите deepinfra (её единственный провайдер).
# Пустая строка = авто-роутинг OpenRouter (НЕ рекомендуется).
# Если EXTERNAL_EMBEDDER_ENDPOINT указывает не на OpenRouter, задайте пустое значение.
EXTERNAL_EMBEDDER_PROVIDER=nebius

# Формат индекса: float32 (по умолчанию, точная точность, ~1.4 ГБ — влезает
# в 4 ГБ RAM сервера), float16 (716 МБ, качество ≈ float32) или int8 (легаси,
# искажает ранжирование — не использовать). Только для сборки индекса.
EMBED_INDEX_DTYPE=float32

# Сохранить дополнительно полную float32-версию векторов (~1.4 ГБ) для
# диагностики/будущего re-rank: EMBED_SAVE_F32=1
EMBED_SAVE_F32=
