.venv/
.git/
__pycache__/
*.pyc
.DS_Store
.pytest_cache/
model_cache/
# EPUB файлы не нужны на сервере (только txt для индексации)
data/Толстой*
data/90*/
# TEI-исходники не нужны на сервере (только распарсенные data/tei_*.txt)
data/tolstoy-tei/
# вытесненные TEI'ем EPUB-тома (46–90) — вне корпуса, на сервере не нужны
data/unused_tom/
# не копируем индексы — они собираются/пересобираются на сервере.
# Исключение также защищает их от удаления rsync --delete на сервере.
index*/
# локальные артефакты
.deploy
deploy.sh
.rsyncignore
# самоподписанные сертификаты больше не нужны (TLS на Caddy)
certs/
# визуализация: .venv и out/ НЕ возим.
#   .venv — сотни МБ, на сервере собирается своим uv sync (uv.lock едет).
#   out/ — серверная сборка авторитетна (обновляется make visualization на
#   сервере после make embeddings); исключение защищает её от перезаписи
#   локальной и от удаления rsync --delete. Первый раз out/ докладывает
#   deploy.sh (bootstrap), если на сервере её ещё нет.
#   cache/ — возим намеренно: серверный билд инкрементальный, а штамп индекса
#   (cache/index_stamp.txt) защищает от переиспользования кэша чужого индекса.
visualization/.venv/
visualization/out/
visualization/src/__pycache__/

# Verbatis (единственный источник корпуса): на сервер едут только 5 основных
# .jsonl (corpus.py читает только их). .git/ уже исключён глобально.
data/verbatis/data/raw/tolstoy/*.csv
data/verbatis/data/raw/tolstoy/*.txt
data/verbatis/data/raw/tolstoy/*_for_embedding.jsonl

# tei_*.txt корпус больше не читает (Verbatis заменил TEI). ВНИМАНИЕ: rsync
# --delete исключённые не удаляет — старые копии на сервере снести вручную
# один раз. tom*.txt же удалятся сами: они уехали в data/90.../ (исключён) и
# под эти исключения не подпадают.
data/tei_*.txt
