verbatis.ru {
    # Reverse proxy с форвардингом заголовков
    reverse_proxy localhost:8000 {
        # Форвардим реальный IP клиента в приложение
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Логи
    log {
        output file /var/log/caddy/verbatis.log
        format json
    }

    # Заголовки безопасности в ответах клиенту
    header {
        # Включить HSTS (только после проверки что всё работает!)
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # Защита от XSS
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        # Удаляем заголовок Server для безопасности
        -Server
    }
}

# Пример для добавления других сервисов на поддоменах:
# api.verbatis.ru {
#     reverse_proxy localhost:9000
# }
#
# admin.verbatis.ru {
#     reverse_proxy localhost:9001
#     basicauth {
#         # Генерировать: caddy hash-password
#         admin $2a$14$...hash...
#     }
# }
